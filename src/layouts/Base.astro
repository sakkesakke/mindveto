---
import '../styles/site.css';
import { LANGS, RTL, ROUTES, href, SITE, type Lang, type PageKey } from '../i18n/routes';
import { UI } from '../i18n/ui';
import { PRODUCT_NAMES } from '../i18n/products';
import { COMPANY } from '../i18n/company';

interface Props { lang: Lang; page: PageKey; title: string; desc: string; jsonld?: object[] }
const { lang, page, title, desc, jsonld = [] } = Astro.props;
const t = UI[lang];
const url = SITE + href(page, lang);
const nav: PageKey[] = ['parents', 'schools', 'offices', 'download', 'pricing', 'help'];
const productKeys: PageKey[] = ['browser', 'android', 'windows', 'maclinux', 'network', 'exam', 'paste'];
const org = {
  '@context': 'https://schema.org', '@type': 'Organization', name: 'Mindveto', url: SITE + '/',
  logo: SITE + '/icon-512.png', slogan: 'The AI kill switch', founder: { '@type': 'Person', name: 'Amghar Said' },
  description: 'Mindveto makes an AI blocker for browsers, Android, Windows, Mac, Linux and networks. It runs on the device and collects no personal data.',
  foundingDate: '2026', areaServed: 'Worldwide', knowsAbout: ['AI blocking', 'parental controls', 'exam proctoring without surveillance', 'data loss prevention for AI chatbots'],
  email: 'hello@mindveto.app', contactPoint: { '@type': 'ContactPoint', contactType: 'customer support', email: 'hello@mindveto.app', availableLanguage: ['en', 'nl', 'fr'] },
  inLanguage: [...LANGS],
};
const fullTitle = page === 'home' || title.length > 48 ? title : `${title} | Mindveto`;
---
<!doctype html>
<html lang={lang} dir={RTL.includes(lang) ? 'rtl' : 'ltr'}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; media-src 'self'; font-src 'self'; connect-src 'self' https://zslzbfbqrtfpvgbjhssd.supabase.co; base-uri 'none'; form-action 'none'">
<meta name="referrer" content="no-referrer">
{page === 'home' && lang === 'en' && <meta name="msvalidate.01" content="5362FF5C002484ACBDACAEB45CE456C3">}
<title>{fullTitle}</title>
<meta name="description" content={desc}>
<link rel="canonical" href={url}>
{LANGS.map((l) => <link rel="alternate" hreflang={l} href={SITE + href(page, l)} />)}
<link rel="alternate" hreflang="x-default" href={SITE + href(page, 'en')}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Mindveto">
<meta property="og:title" content={title}>
<meta property="og:description" content={desc}>
<meta property="og:url" content={url}>
<meta property="og:image" content={SITE + '/og.png'}>
<meta property="og:locale" content={t.locale}>
<meta name="twitter:card" content="summary_large_image">
<meta name="theme-color" content="#e6eae4">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="apple-touch-icon" href="/icon-512.png">
<link rel="preload" href="/fonts/atkinson-hyperlegible-next-latin-wght-normal.woff2" as="font" type="font/woff2" crossorigin>
<script type="application/ld+json" set:html={JSON.stringify([org, ...jsonld])} />
</head>
<body>
<a class="skip" href="#main">{t.skip}</a>
<header class="top">
  <div class="wrap">
    <a class="brand" href={href('home', lang)}>
      <svg viewBox="0 0 44 62" aria-hidden="true"><rect x="2.5" y="2.5" width="39" height="57" rx="11" fill="#f6f7f3" stroke="#18241f" stroke-width="5"/><rect x="12" y="12" width="20" height="38" rx="5" fill="#fff" stroke="#18241f" stroke-width="2.5"/><path d="M12 31h20v14a5 5 0 0 1-5 5H17a5 5 0 0 1-5-5z" fill="#18241f"/><circle cx="22" cy="20" r="2.4" fill="#5b3ce0"/></svg>
      Mindveto<span class="tag">The AI kill switch</span>
    </a>
    <details class="menu"><summary>{t.menu}</summary>
      <nav class="nav" aria-label={t.navLabel}>
        {nav.map((k) => <a href={href(k, lang)} aria-current={k === page ? 'page' : undefined}>{t[k]}</a>)}
      </nav>
    </details>
    <nav class="nav" aria-label={t.navLabel}>
      {nav.map((k) => <a href={href(k, lang)} aria-current={k === page ? 'page' : undefined}>{t[k]}</a>)}
    </nav>
    <details class="langsw"><summary><span class="sr">{t.langLabel}: </span>{lang.toUpperCase()}</summary>
      <div class="langs">
        {LANGS.map((l) => <a href={href(page, l)} hreflang={l} lang={l} aria-current={l === lang ? 'true' : undefined}>{UI[l].langName}</a>)}
      </div>
    </details>
  </div>
</header>
<main id="main">
  <slot />
</main>
<footer class="foot">
  <div class="wrap">
    <div class="cols">
      <div>
        <p class="fbrand"><img src="/brand/mark-dark.svg" alt="" width="22" height="31"><strong>Mindveto</strong><span>The AI kill switch</span></p>
        <p>{t.tagline}</p>
        <p><a href="mailto:hello@mindveto.app">hello@mindveto.app</a></p>
      </div>
      <div>
        <h2>{t.products}</h2>
        <ul>{productKeys.map((k) => <li><a href={href(k, lang)}>{PRODUCT_NAMES[lang][k]}</a></li>)}</ul>
      </div>
      <div>
        <h2>{t.forWho}</h2>
        <ul>
          <li><a href={href('parents', lang)}>{t.parents}</a></li>
          <li><a href={href('schools', lang)}>{t.schools}</a></li>
          <li><a href={href('offices', lang)}>{t.offices}</a></li>
          <li><a href={href('pricing', lang)}>{t.pricing}</a></li>
          <li><a href={href('guide', lang)}>{t.guide}</a></li>
          <li><a href={href('family', lang)}>{t.family}</a></li>
        </ul>
      </div>
      <div>
        <h2>{t.company}</h2>
        <ul>
          <li><a href={href('about', lang)}>{t.about}</a></li>
          <li><a href={href('help', lang)}>{t.help}</a></li>
          <li><a href={href('privacy', lang)}>{t.privacy}</a></li>
          <li><a href={href('terms', lang)}>{t.terms}</a></li>
          <li><a href={href('legal', lang)}>{t.legal}</a></li>
        </ul>
      </div>
    </div>
    <p class="fine">© 2026 Amghar Said{COMPANY.kbo ? ` · ${t.ent} ${COMPANY.kbo}` : ''}{COMPANY.address ? ` · ${COMPANY.address}` : ''}. {t.fine}</p>
  </div>
</footer>
</body>
</html>
