---
import Base from '../layouts/Base.astro';
---
<Base lang="en" page="home" title="Page not found | Mindveto" desc="This page does not exist. Go to the Mindveto home page.">
  <header class="pagehead">
    <div class="wrap">
      <h1>This page does not exist.</h1>
      <p class="lead">The address may have changed. Start from the home page, or pick your language.</p>
      <div class="actions">
        <a class="btn solid" href="/">Home</a>
        <a class="btn line" href="/nl/" lang="nl">Nederlands</a>
        <a class="btn line" href="/fr/" lang="fr">Français</a>
        <a class="btn line" href="/es/" lang="es">Español</a>
        <a class="btn line" href="/de/" lang="de">Deutsch</a>
        <a class="btn line" href="/pt/" lang="pt">Português</a>
        <a class="btn line" href="/it/" lang="it">Italiano</a>
        <a class="btn line" href="/ar/" lang="ar" dir="rtl">العربية</a>
      </div>
    </div>
  </header>
</Base>
