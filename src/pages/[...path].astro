---
import Base from '../layouts/Base.astro';
import { LANGS, ROUTES, href, SITE, type Lang, type PageKey } from '../i18n/routes';
import { UI } from '../i18n/ui';
import { localize } from '../i18n/localize';
import { PRODUCT_NAMES, PRODUCT_LINES, PRODUCT_KEYS } from '../i18n/products';
import { VETO_CAP, AI_NAMES, PLANS, EXAM_UI, CHECK_UI, CHECK_SVC, STREAM_LABEL, PASTE_MOCK, UI_PREVIEW } from '../i18n/extra';
import type { Action, Home, Page } from '../i18n/types';
import { PROTECT } from '../i18n/protect';
import { LINKABLE } from '../i18n/linkable';
import LC_JS from '../scripts/linkcheck.js?raw';
import QZ_JS from '../scripts/quiz.js?raw';
import TR_JS from '../scripts/trace.js?raw';
import { TRACE } from '../i18n/trace';
import * as en from '../i18n/en';
import * as nl from '../i18n/nl';
import * as fr from '../i18n/fr';
import * as es from '../i18n/es';
import * as de from '../i18n/de';
import * as pt from '../i18n/pt';
import * as it from '../i18n/it';
import * as ar from '../i18n/ar';

const CONTENT = { en, nl, fr, es, de, pt, it, ar } as const;

export function getStaticPaths() {
  const out = [];
  for (const key of Object.keys(ROUTES) as PageKey[]) {
    for (const lang of LANGS) {
      const p = ROUTES[key][lang].replace(/\/$/, '');
      out.push({ params: { path: p || undefined }, props: { key, lang } });
    }
  }
  return out;
}

const { key, lang } = Astro.props as { key: PageKey; lang: Lang };
const t = UI[lang];
const C = localize(CONTENT[lang], lang);
const isHome = key === 'home';
const h: Home = C.home;
const pg: Page | undefined = isHome ? undefined : C.pages[key];
const isProduct = PRODUCT_KEYS.includes(key);

const link = (a: Action) => (a.to ? href(a.to, lang) : a.url!);
const title = isHome ? h.title : pg!.title;
const desc = isHome ? h.desc : pg!.desc;

const BUILT = new Date().toISOString().slice(0, 10);
const inBlog = ROUTES[key].en.startsWith('blog/');
const LKU = LINKABLE[lang].ui;
const fmtDate = (d: string) => new Date(d + 'T12:00:00Z').toLocaleDateString(lang === 'en' ? 'en-GB' : lang, { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
// Statistics are numbered across all blocks of a page, so every figure has a stable anchor (#s1, #s2 …).
const statFrom: number[] = [];
(pg?.blocks ?? []).reduce((n, b) => { statFrom.push(n); return n + (b.stats?.length ?? 0); }, 0);
const jsonld: object[] = [{
  '@context': 'https://schema.org', '@type': 'WebPage', name: title, description: desc, url: SITE + href(key, lang), inLanguage: lang,
  dateModified: BUILT, isPartOf: { '@type': 'WebSite', name: 'Mindveto', url: SITE + '/' },
}];
if (!isHome) {
  jsonld.push({
    '@context': 'https://schema.org', '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Mindveto', item: SITE + href('home', lang) },
      ...(inBlog ? [{ '@type': 'ListItem', position: 2, name: 'Blog', item: SITE + href('blog', lang) }] : []),
      { '@type': 'ListItem', position: inBlog ? 3 : 2, name: pg!.h1.replace(/\.$/, ''), item: SITE + href(key, lang) },
    ],
  });
  if (pg!.article) jsonld.push({
    '@context': 'https://schema.org', '@type': 'Article', headline: pg!.title, description: pg!.desc, inLanguage: lang,
    datePublished: pg!.article.date, dateModified: pg!.article.updated ?? pg!.article.date, mainEntityOfPage: SITE + href(key, lang),
    author: { '@type': 'Person', name: 'Amghar Said', url: SITE + href('about', lang), sameAs: ['https://www.linkedin.com/in/amghar-said-67a95a22/'] },
    publisher: { '@type': 'Organization', name: 'Mindveto', url: SITE + '/', logo: { '@type': 'ImageObject', url: SITE + '/icon-512.png' } },
    citation: pg!.article.sources.map(([, u]) => u),
  });
  if (pg!.faq?.length) jsonld.push({
    '@context': 'https://schema.org', '@type': 'FAQPage',
    mainEntity: pg!.faq.map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a.replace(/<[^>]+>/g, '') } })),
  });
  if (isProduct && key !== 'exam' && key !== 'paste') jsonld.push({
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Mindveto ' + PRODUCT_NAMES[lang][key],
    applicationCategory: 'SecurityApplication', operatingSystem: { browser: 'Chrome, Edge, Brave, Opera', android: 'Android 8+', windows: 'Windows 10, Windows 11', maclinux: 'macOS, Linux', network: 'Any' }[key as string],
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, author: { '@type': 'Person', name: 'Amghar Said', sameAs: ['https://www.linkedin.com/in/amghar-said-67a95a22/'] }, url: SITE + href(key, lang),
  });
  if (key === 'paste' || key === 'offices') jsonld.push({
    '@context': 'https://schema.org', '@type': 'VideoObject', name: pg!.title, description: pg!.desc, inLanguage: lang,
    thumbnailUrl: `${SITE}/media/paste-guard-${lang}.jpg`, contentUrl: `${SITE}/media/paste-guard-${lang}.mp4`,
    uploadDate: '2026-11-12T12:00:00+01:00', duration: 'PT9S',
  });
} else {
  jsonld.push({ '@context': 'https://schema.org', '@type': 'WebSite', name: 'Mindveto', url: SITE + '/', inLanguage: [...LANGS] });
  jsonld.push({
    '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Mindveto', description: desc, url: SITE + href('home', lang),
    applicationCategory: 'SecurityApplication', operatingSystem: 'Chrome, Edge, Brave, Opera, Android 8+, Windows 10, Windows 11, macOS, Linux',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' }, author: { '@type': 'Person', name: 'Amghar Said', sameAs: ['https://www.linkedin.com/in/amghar-said-67a95a22/'] },
  });
}
const X = EXAM_UI[lang];
const K = CHECK_UI[lang];
const DEMO = { h: t.demoH, cap: t.demoCap };
const VL = ['en', 'nl', 'fr'].includes(lang) ? lang : 'en'; // demo videos exist in EN/NL/FR; other languages show the English one
const M = PASTE_MOCK[lang] ?? PASTE_MOCK.en;
const NO_ASIDE: PageKey[] = ['help', 'about', 'privacy', 'terms', 'legal', 'pricing', 'download', 'policy', 'guide', 'family', 'blog', 'charai', 'aiact', 'linkcheck', 'quiz', 'stats', 'gdpr', 'trace'];
const ASIDE: Partial<Record<PageKey, string>> = { offices: 'paste', paste: 'paste', browser: 'popup', parents: 'switch', schools: 'popup', exam: 'exam', android: 'phone', windows: 'win', maclinux: 'mac', network: 'list', about: 'switch' };
const aside = isHome || NO_ASIDE.includes(key) ? null : ASIDE[key] ?? null;
const U = UI_PREVIEW[lang] ?? UI_PREVIEW.en;
const P = PLANS[lang];
const PR = localize(PROTECT[lang], lang);
const js = (name: string, data: object, code: string) => `var ${name}=${JSON.stringify(data).replace(/</g, '\\u003c')};\n${code}`;
const TRU = TRACE[lang].ui;
const LC_EX = [['https://www.ing.com/', PR.lc.exGood], ['https://paypa1-login.com/verify', PR.lc.exBad], ['https://xn--pypal-4ve.com/', PR.lc.exHidden]];
---
<Base lang={lang} page={key} title={title} desc={desc} jsonld={jsonld}>
{isHome ? (
  <>
  <div id="hz" class="vetoed">
  <section class="hero" aria-labelledby="h1">
    <div class="wrap">
      <div>
        <h1 id="h1">{h.h1.replace(/\.$/, '')}</h1>
        <p class="lead">{h.lead}</p>
        <div class="actions">
          <a class="btn solid" href={href('download', lang)}>{t.getFree}</a>
          <a class="btn line" href="#who">{h.doorsH}</a>
        </div>
        <p class="trust">{h.trust}</p>
        <p class="motto">{h.motto}</p>
      </div>
      <div class="plate">
        <div class="bmock" aria-hidden="true">
          <div class="bbar"><i></i><i></i><i></i><span dir="ltr">chatgpt.com</span></div>
          <p><span class="m-on">{h.mockOn}</span><span class="m-off">{h.mockOff}</span></p>
        </div>
        <button class="switch" id="sw" type="button" role="switch" aria-checked="true" aria-label={h.switchLabel}>
          <span class="screw t"></span>
          <span class="rocker" data-on={h.switchOn} data-off={h.switchOff}><span class="led"></span></span>
          <span class="screw b"></span>
        </button>
        <p class="status" id="st" aria-live="polite">{h.statusOff}</p>
      </div>
    </div>
  </section>
  <section class="stream" aria-label="AI services">
    <div class="wrap"><p><span class="lbl">{STREAM_LABEL[lang]}</span> {AI_NAMES.slice(0, 9).map((n, i) => <><span style={`transition-delay:${i * 40}ms`}>{n}</span>{' '}</>)}<span style={`transition-delay:${9 * 40}ms`}>+150</span></p></div>
  </section>
  </div>

  <section class="band paper" id="who" aria-labelledby="who-h">
    <div class="wrap">
      <h2 id="who-h">{h.doorsH}</h2>
      <ul class="doors">
        {h.doors.map((d) => <li><a href={href(d.key, lang)}><span class="who">{d.who}</span><span class="why">{d.why}</span><span class="go">{d.go}</span></a></li>)}
      </ul>
    </div>
  </section>

  <section class="band" aria-labelledby="pr-h">
    <div class="wrap">
      <h2 id="pr-h">{h.productsH}</h2>
      <p class="lead">{h.productsLead}</p>
      <div class="toolsplit">
        <ul class="toollist">
          {PRODUCT_KEYS.map((k) => <li><a href={href(k, lang)}><span class="tn">{PRODUCT_NAMES[lang][k]}</span><span class="tl">{PRODUCT_LINES[lang][k]}</span></a></li>)}
        </ul>
        <figure class="mock">
          <div class="ui-pop" aria-hidden="true">
            <div class="ui-head"><img src="/favicon.svg" alt="" width="14" height="20">Mindveto</div>
            <div class="ui-big"><span>{U.on}</span><small>{U.tapOff}</small></div>
            <p class="ui-st">{U.st}</p>
            <p class="ui-h">{U.cats}</p>
            <ul>{U.c.map(([n, c, on]) => <li><span class={'ui-box' + (on ? ' on' : '')}></span>{n}<small>{c}</small></li>)}</ul>
            <p class="ui-pin">{U.pin}</p>
          </div>
          <figcaption>{U.label}</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="band paper" aria-labelledby="pf-h">
    <div class="wrap split">
      <div><h2 id="pf-h">{h.proofH}</h2><p>{h.proofP}</p></div>
      <ul class="ledger">{h.ledger.map(([a, b, z]) => <li class={z ? 'zero' : ''}><b>{a}</b><span>{b}</span></li>)}</ul>
    </div>
  </section>

  <section class="band" aria-labelledby="lm-h">
    <div class="wrap split">
      <div><h2 id="lm-h">{h.limitsH}</h2></div>
      <ul class="rules">{h.limits.map((l) => <li>{l}</li>)}</ul>
    </div>
  </section>

  <section class="band paper" aria-labelledby="pc-h">
    <div class="wrap split">
      <div><h2 id="pc-h">{h.priceH}</h2></div>
      <div><p class="lead">{h.priceP}</p><p><a class="btn line" href={href('pricing', lang)}>{h.priceGo}</a></p></div>
    </div>
  </section>

  <script is:inline define:vars={{ sOn: h.statusOn, sOff: h.statusOff }}>
    var sw = document.getElementById('sw'), st = document.getElementById('st');
    sw.addEventListener('click', function () {
      var v = sw.getAttribute('aria-checked') !== 'true';
      sw.setAttribute('aria-checked', String(v));
      document.getElementById('hz').classList.toggle('vetoed', v);
      st.textContent = v ? sOff : sOn;
    });
  </script>
  </>
) : (
  <>
  <div class={'wrap pgrid' + (aside ? ' hasside' : '')}>
  <div class="pmain">
  <header class="pagehead">
      <div>
        {isProduct && <p class="crumbs"><a href={href('home', lang)}>Mindveto</a> / <a href={href('download', lang)}>{t.products}</a></p>}
        <h1>{pg!.h1.replace(/\.$/, '')}</h1>
        <p class="lead">{pg!.lead}</p>
        {pg!.article && <p class="small byline">{t.by} <a href={href('about', lang)}>Amghar Said</a> · <time datetime={pg!.article.date}>{fmtDate(pg!.article.date)}</time></p>}
        {pg!.checked && <p class="small checked">{LKU.checked}: <time datetime={pg!.checked}>{fmtDate(pg!.checked)}</time></p>}
        {pg!.actions && <div class="actions">{pg!.actions.map((a) => <a class={'btn ' + (a.solid ? 'solid' : 'line')} href={link(a)} download={a.download ? '' : undefined}>{a.label}</a>)}</div>}
      </div>
      {aside && aside !== 'switch' && <div class="mside">
      {aside === 'paste' && (
        <figure class="pmock" aria-label={M.h}>
          <p class="pm-h">{M.h}</p>
          <p class="pm-p">{M.p}</p>
          <ul>{M.found.map((f) => <li>{f}</li>)}</ul>
          <div class="pm-b"><span class="pm-btn solid">{M.a}</span><span class="pm-btn">{M.b}</span><span class="pm-btn ghost">{M.c}</span></div>
        </figure>
      )}
      {(aside === 'popup' || aside === 'exam') && (
        <figure class="mock">
          <div class="ui-pop" aria-hidden="true">
            <div class="ui-head"><img src="/favicon.svg" alt="" width="14" height="20">Mindveto</div>
            {aside === 'exam' && <p class="ui-exam">{U.exam}</p>}
            <div class="ui-big"><span>{U.on}</span><small>{U.tapOff}</small></div>
            <p class="ui-st">{U.st}</p>
            <p class="ui-h">{U.cats}</p>
            <ul>{U.c.map(([n, c, on]) => <li><span class={'ui-box' + (on ? ' on' : '')}></span>{n}<small>{c}</small></li>)}</ul>
            <p class="ui-pin">{U.pin}</p>
          </div>
          <figcaption>{U.label}</figcaption>
        </figure>
      )}
      {aside === 'phone' && (
        <figure class="mock">
          <div class="ui-phone" aria-hidden="true">
            <div class="ui-ph-in">
              <p class="ui-ph-t">MINDVETO</p><p class="ui-ph-s">{U.aSub}</p>
              <div class="ui-ph-btn">{U.aOn}</div>
              <p class="ui-ph-tap">{U.aTap}</p>
              <p class="ui-st">{U.aSt}</p>
              <div class="ui-ph-card">{U.aAlways}</div>
            </div>
          </div>
          <figcaption>{U.label}</figcaption>
        </figure>
      )}
      {(aside === 'win' || aside === 'mac' || aside === 'list') && (
        <figure class="mock">
          <pre class="ui-term" role="region" tabindex="0" aria-label={U.label}><code>{aside === 'win' ? `  MINDVETO  -  the AI kill switch

  1) Block AI on this PC
     (or update the list)
  2) Allow AI again
     (remove the block)
  3) Turn off the AI built into
     Windows, Edge and Chrome
     (Copilot, Recall, ...)
  4) Turn that built-in AI back on
  5) Family filter ON
  6) Family filter OFF
  7) Quit

  Choice: 1

  Done: 161 AI addresses are blocked
  on this PC. Restart your browser.` : aside === 'mac' ? `$ sudo sh mindveto.sh on
Password:
Terms: provided "as is" ...
Agree? (y/n) y
Done: 161 AI addresses blocked.
Restart your browser.

$ sudo sh mindveto.sh off
AI is allowed again.` : `! Title: Mindveto AI block list
! Domains: 161
||chatgpt.com^
||chat.openai.com^
||gemini.google.com^
||claude.ai^
||copilot.microsoft.com^
||perplexity.ai^
||chat.deepseek.com^
||character.ai^
...`}</code></pre>
          <figcaption>{U.label}</figcaption>
        </figure>
      )}
      {aside === 'switch' && (
        <figure class="plate mini" aria-hidden="true">
          <span class="switch" aria-checked="true"><span class="screw t"></span><span class="rocker" data-on={h.switchOn} data-off={h.switchOff}><span class="led"></span></span><span class="screw b"></span></span>
          <figcaption class="status">{VETO_CAP[lang]}</figcaption>
        </figure>
      )}
      </div>}
  </header>
  <div class="prose">
    <div>
      {key === 'exam' && (
        <section aria-label={X.mkH}>
          <div class="tool" id="make">
            <h2>{X.mkH}</h2>
            <p>{X.mkP}</p>
            <button class="btn solid" id="mk" type="button">{X.mkB}</button>
          </div>
          <div class="tool" id="klass" hidden>
            <h2>{X.clH}</h2>
            <div class="code" id="code" aria-live="polite"></div>
            <ol class="steps"><li>{X.s1}</li><li>{X.s2}</li><li>{X.s3}</li></ol>
            <div class="actions"><button class="btn line" id="copy" type="button">{X.cp}</button><button class="btn line" id="forget" type="button">{X.fg}</button></div>
            <p class="small">{X.keep}</p>
          </div>
          <div class="tool" id="exam" hidden>
            <h2>{X.exH}</h2>
            <p class="state off" id="state" aria-live="polite"></p>
            <label for="mins">{X.dur}</label><br>
            <select id="mins"><option value="30">30 min</option><option value="45">45 min</option><option value="60" selected>60 min</option><option value="90">90 min</option><option value="120">120 min</option><option value="180">180 min</option><option value="240">240 min</option></select>
            <button class="btn solid" id="go" type="button">{X.go}</button>
            <div class="actions"><button class="btn line" id="stop" type="button">{X.st}</button></div>
            <p class="small">{X.lim}</p>
          </div>
          <p class="msg" id="msg" role="alert"></p>
          <script is:inline define:vars={{ X }}>
          (function(){
          var API='https://zslzbfbqrtfpvgbjhssd.supabase.co/rest/v1/rpc/',KEY='sb_publishable_90hLwzv3xb0aZmPtaHKZag_1hKkG0EN';
          var CODE=/^[A-HJ-NP-Z2-9]{8}$/,TKEY=/^[0-9a-f]{64}$/;
          var $=function(i){return document.getElementById(i)},C=null,until=0,armed=0;
          function msg(s){$('msg').textContent=s||''}
          function rpc(fn,body){return fetch(API+fn,{method:'POST',cache:'no-store',credentials:'omit',headers:{apikey:KEY,'Content-Type':'application/json'},body:JSON.stringify(body||{})}).then(function(r){if(!r.ok)throw new Error('http');return r.json()})}
          function save(){try{if(C)localStorage.setItem('ho_class',JSON.stringify(C));else localStorage.removeItem('ho_class')}catch(e){}}
          function load(){var other=false;try{var s=JSON.parse(localStorage.getItem('ho_class')||'null');if(s&&CODE.test(s.code)&&TKEY.test(s.key))C={code:s.code,key:s.key};
            var h=location.hash.slice(1).split('.');if(h.length===2&&CODE.test(h[0])&&TKEY.test(h[1])){history.replaceState(null,'',location.pathname);
              if(C&&(C.code!==h[0]||C.key!==h[1]))other=true;else{C={code:h[0],key:h[1]};save()}}}catch(e){}return other}
          function fmt(ms){var s=Math.max(0,Math.round(ms/1000)),m=Math.floor(s/60);s=s%60;return m+':'+(s<10?'0':'')+s}
          function draw(){$('make').hidden=!!C;$('klass').hidden=!C;$('exam').hidden=!C;if(!C)return;
            $('code').textContent=C.code.slice(0,4)+'-'+C.code.slice(4);
            var on=until>Date.now(),st=$('state');st.className='state '+(on?'on':'off');st.textContent=on?X.on.replace('{t}',fmt(until-Date.now())):X.off;$('stop').disabled=!on;}
          function poll(){if(!C)return;rpc('exam_status',{p_code:C.code}).then(function(n){if(n===-1){msg(X.bad);return}if(typeof n==='number'){until=n>0?Date.now()+n*1000:0;draw()}}).catch(function(){})}
          function set(min){msg('');$('go').disabled=true;rpc('exam_set',{p_code:C.code,p_key:C.key,p_minutes:min}).then(function(j){$('go').disabled=false;
            if(j&&j.ok){until=min>0?Date.now()+min*60000:0;draw()}else msg(j&&j.err==='slow'?X.slow:X.bad)}).catch(function(){$('go').disabled=false;msg(X.net)})}
          $('mk').onclick=function(){msg('');$('mk').disabled=true;rpc('exam_create').then(function(j){$('mk').disabled=false;
            if(j&&CODE.test(j.code)&&TKEY.test(j.key)){C={code:j.code,key:j.key};save();until=0;draw()}else msg(X.slow)}).catch(function(){$('mk').disabled=false;msg(X.net)})};
          $('go').onclick=function(){set(parseInt($('mins').value,10)||60)};
          $('stop').onclick=function(){set(0)};
          $('copy').onclick=function(){var u=location.origin+location.pathname+'#'+C.code+'.'+C.key;(navigator.clipboard?navigator.clipboard.writeText(u):Promise.reject()).then(function(){msg(X.copied)},function(){msg(u)})};
          $('forget').onclick=function(){if(Date.now()-armed>5000){armed=Date.now();$('forget').textContent=X.yes;return}C=null;save();until=0;armed=0;$('forget').textContent=X.fg;draw()};
          addEventListener('hashchange',function(){if(location.hash.length>1){var o=load();until=0;draw();poll();msg(o?X.other:'')}});
          var other=load();draw();poll();setInterval(poll,20000);setInterval(draw,1000);if(other)msg(X.other);
          })();
          </script>
        </section>
      )}

      {key === 'check' && (
        <section aria-label={K.btn}>
          <div class="tool" id="check">
            <p class="small">{K.pv}</p>
            <button class="btn solid" id="ck" type="button">{K.btn}</button>
            <p class="state off" id="cksum" aria-live="polite" hidden></p>
            <table class="cktab">
              <thead><tr><th scope="col">{K.svc}</th><th scope="col">{K.res}</th></tr></thead>
              <tbody>{CHECK_SVC.map(([n, d]) => <tr><td>{n}</td><td data-d={d}>–</td></tr>)}</tbody>
            </table>
            <p class="small" id="ckhint" hidden>{K.hint}</p>
          </div>
          <script is:inline define:vars={{ K }}>
          (function(){
          var b=document.getElementById('ck'),sum=document.getElementById('cksum'),hint=document.getElementById('ckhint'),cells=[].slice.call(document.querySelectorAll('.cktab td[data-d]'));
          // 'blocked' = the request failed fast (Mindveto, another filter or a site outage); 'none' = no answer within 6 s.
          // A normal site (Wikipedia) is probed as a control: if it fails too, the test cannot say anything.
          function probe(d,path){var c=new AbortController(),t=setTimeout(function(){c.abort()},6000);
            return fetch('https://'+d+(path||'/favicon.ico')+'?mv='+Date.now(),{mode:'no-cors',cache:'no-store',credentials:'omit',referrerPolicy:'no-referrer',signal:c.signal})
              .then(function(){clearTimeout(t);return 'open'},function(e){clearTimeout(t);return e&&e.name==='AbortError'?'none':'blocked'})}
          function verdict(rs,ctl){var t=rs.length,n=function(k){return rs.filter(function(r){return r===k}).length},open=n('open'),bl=n('blocked'),x=n('none');
            if(open) return ['on',open===t?K.zero:K.some.replace('{n}',open).replace('{t}',t)];
            if(ctl!=='open') return ['off warn',K.ctl];
            if(bl===0) return ['off warn',K.unk];
            if(x) return ['off warn',K.part.replace('{b}',bl).replace('{t}',t).replace('{x}',x)];
            return ['off',K.all]}
          b.onclick=function(){b.disabled=true;b.textContent=K.run;sum.hidden=true;hint.hidden=true;cells.forEach(function(c){c.textContent='…';c.className=''});
            fetch('/robots.txt?mv='+Date.now(),{cache:'no-store'}).then(function(){
              return Promise.all([probe('www.wikipedia.org','/static/favicon/wikipedia.ico')].concat(cells.map(function(c){return probe(c.dataset.d).then(function(r){c.textContent=K[r];c.className='ck-'+r;return r})})))
                .then(function(all){var v=verdict(all.slice(1),all[0]);sum.className='state '+v[0];sum.textContent=v[1];sum.hidden=false;hint.hidden=v[0]==='off'})
            },function(){sum.className='state off warn';sum.textContent=K.offline;sum.hidden=false;cells.forEach(function(c){c.textContent='–'})})
            .then(function(){b.disabled=false;b.textContent=K.btn})};
          })();
          </script>
        </section>
      )}

      {key === 'linkcheck' && (
        <section aria-label={PR.lc.btn}>
          <div class="tool lk">
            <form id="lcf" role="search" novalidate>
              <label for="lcu">{PR.lc.label}</label>
              <div class="lk-row">
                <input id="lcu" name="u" type="text" dir="ltr" inputmode="url" autocomplete="off" autocapitalize="off" spellcheck="false" maxlength="2000" placeholder="https://">
                <button class="btn solid" type="submit">{PR.lc.btn}</button>
              </div>
            </form>
            <p class="small">{PR.lc.pv}</p>
            <p class="small lk-ex">{PR.lc.ex} {LC_EX.map(([u, l]) => <><button class="lk-exb" type="button" data-ex={u}>{l}</button>{' '}</>)}</p>
            <div id="lcout" aria-live="polite" hidden></div>
          </div>
          <script is:inline set:html={js('L', PR.lc, LC_JS)} />
        </section>
      )}

      {key === 'trace' && (
        <section id="trace" aria-label={pg!.h1}>
          <div class="actions tr-modes" role="group" aria-label={TRU.group}>
            <button class="btn solid" id="tr-ms" type="button" aria-pressed="true">{TRU.modeS}</button>
            <button class="btn line" id="tr-mt" type="button" aria-pressed="false">{TRU.modeT}</button>
          </div>
          <div class="tool tr" id="tr-s">
            <p class="small">{TRU.pv}</p>
            <div class="tr-row">
              <div><label for="tr-name">{TRU.nameL}</label><input id="tr-name" type="text" autocomplete="off" maxlength="80"></div>
              <div><label for="tr-task">{TRU.taskL}</label><input id="tr-task" type="text" autocomplete="off" maxlength="120"></div>
            </div>
            <label for="tr-text">{TRU.textL}</label>
            <textarea id="tr-text" rows="14" maxlength="60000"></textarea>
            <p class="small" id="tr-info"></p>
            <div class="actions"><button class="btn solid" id="tr-done" type="button">{TRU.done}</button><button class="btn line" id="tr-new" type="button">{TRU.newB}</button></div>
            <p class="small">{TRU.hand}</p>
          </div>
          <div class="tool tr" id="tr-t" hidden>
            <label for="tr-file">{TRU.fileL}</label>
            <input id="tr-file" type="file" accept=".json,application/json">
            <p class="small">{TRU.pvT}</p>
            <div id="tr-out" aria-live="polite"></div>
          </div>
          <script is:inline set:html={js('W', TRU, TR_JS)} />
        </section>
      )}

      {key === 'quiz' && (
        <section id="quiz" aria-labelledby="qz-h">
          <h2 id="qz-h">{PR.qz.h}</h2>
          <p class="small">{PR.qz.pv}</p>
          <ol class="qz">
            {PR.items.map((q, i) => (
              <li class="q tool" data-a={q.a}>
                <h3>{i + 1}. {q.t}</h3>
                <p class="qz-scene">{q.s}</p>
                <div class="actions qz-btns" hidden><button class="btn line" type="button" data-v="real">{PR.qz.real}</button><button class="btn line" type="button" data-v="fake">{PR.qz.fake}</button></div>
                <details class="qz-ans"><summary>{PR.qz.show}</summary><p><strong>{q.a === 'real' ? PR.qz.real : PR.qz.fake}.</strong> <span class="qz-e">{q.e}</span></p></details>
                <p class="qz-fb" hidden></p>
              </li>
            ))}
          </ol>
          <p class="small" id="qleft" aria-live="polite"></p>
          <div class="tool" id="qres" hidden>
            <h2>{PR.qz.resH}</h2>
            <p class="state" id="qscore" aria-live="polite"></p>
            <label for="qname">{PR.qz.name}</label>
            <input id="qname" type="text" autocomplete="off" maxlength="80">
            <div class="actions"><button class="btn solid" id="qprint" type="button">{PR.qz.print}</button><button class="btn line" id="qagain" type="button">{PR.qz.again}</button></div>
          </div>
          <div id="qcert" class="qcert"></div>
          <script is:inline set:html={js('Q', PR.qz, QZ_JS)} />
        </section>
      )}

      {(key === 'paste' || key === 'offices') && (
        <section class="wide demo" aria-label={DEMO.h}>
          <h2>{DEMO.h}</h2>
          <video controls muted playsinline preload="none" width="960" height="540" poster={`/media/paste-guard-${VL}.jpg`}>
            <source src={`/media/paste-guard-${VL}.mp4`} type="video/mp4">
          </video>
          <p class="small">{DEMO.cap}</p>
        </section>
      )}

      {key === 'pricing' && (
        <section aria-label={t.pricing}>
          <div class="plans">
            {P.plans.map((p) => <div class={'plan' + (p.pick ? ' pick' : '')}><div class="ph"><h2>{p.name}</h2><p class="quiet">{p.who}</p><p class="price">{p.price}<span class="per">{p.per}</span></p></div><ul>{p.items.map((i) => <li>{i}</li>)}</ul>{p.sub && <p class="small plan-sub">{p.sub}</p>}<a class="btn line" href={p.to ? href(p.to as PageKey, lang) : `mailto:hello@mindveto.app?subject=${encodeURIComponent(p.mail!)}`}>{p.cta}</a></div>)}
          </div>
          <p class="small">{P.note}</p>
        </section>
      )}

      {pg!.blocks.map((b, i) => (
        <section id={b.steps && i > 0 && isProduct ? 'install' : undefined} class={i === 1 && pg!.blocks.length >= 3 ? 'midband' : undefined}>
          <h2>{b.h}</h2>
          {b.p?.map((x) => <p set:html={x} />)}
          {b.list && <ul>{b.list.map((x) => <li set:html={x} />)}</ul>}
          {b.steps && !b.fold && <ol class="steps">{b.steps.map((x) => <li set:html={x} />)}</ol>}
          {b.steps && b.fold && <><p class="quiet">{b.foldLead}</p><details class="fold"><summary>{b.fold}</summary><ol class="steps">{b.steps.map((x) => <li set:html={x} />)}</ol></details></>}
          {b.stats && <ul class="stats">{b.stats.map(([n, x, src, yr, u], j) => <li id={`s${statFrom[i] + j + 1}`}><p class="sn">{n}</p><p class="st">{x}</p><p class="small ss">{LKU.src}: <a href={u} rel="noopener">{src}</a>{lang === 'ar' ? '، ' : ', '}{yr} · <a href={`#s${statFrom[i] + j + 1}`}>#s{statFrom[i] + j + 1}</a></p></li>)}</ul>}
          {b.facts && <table class="facts"><tbody>{b.facts.map(([a, v]) => <tr><th scope="row">{a}</th><td set:html={v} /></tr>)}</tbody></table>}
          {b.note && <p class={'note' + (b.human ? ' human' : '')}>{b.note}</p>}
          {b.actions && <div class="actions">{b.actions.map((a) => <a class={'btn ' + (a.solid ? 'solid' : 'line')} href={link(a)} download={a.download ? '' : undefined}>{a.label}</a>)}</div>}
        </section>
      ))}

      {pg!.cite && (
        <section class="cite" id="cite">
          <h2>{LKU.cite}</h2>
          <p set:html={pg!.cite} />
        </section>
      )}

      {pg!.article && (
        <section class="sources">
          <h2>{t.sources}</h2>
          <ol>{pg!.article.sources.map(([n, u]) => <li><a href={u} rel="noopener">{n}</a></li>)}</ol>
          <p class="small">{t.notLegal}</p>
        </section>
      )}

      {key === 'policy' && <script is:inline>document.querySelectorAll('a[href="#print"]').forEach(function (a) { a.addEventListener('click', function (e) { e.preventDefault(); window.print(); }); });</script>}

      {(key === 'parents' || key === 'schools' || key === 'offices') && (
        <section aria-labelledby="pr-hub">
          <h2 id="pr-hub">{PR.hub.h}</h2>
          <div class="rels">
            <a class="rel" href={href('linkcheck', lang)}><strong>{PR.hub.lcT}</strong><span>{PR.hub.lcD}</span></a>
            <a class="rel" href={href('quiz', lang)}><strong>{PR.hub.qzT}</strong><span>{PR.hub.qzD}</span></a>
            <a class="rel" href={href('stats', lang)}><strong>{LKU.statsT}</strong><span>{LKU.statsD}</span></a>
            {key === 'offices' && <a class="rel" href={href('gdpr', lang)}><strong>{LKU.gdprT}</strong><span>{LKU.gdprD}</span></a>}
          </div>
        </section>
      )}

      {pg!.faq && (
        <section class="faq">
          <h2>{t.help}</h2>
          {pg!.faq.map((f) => <details><summary>{f.q}</summary><p set:html={f.a} /></details>)}
        </section>
      )}

      {pg!.related && (
        <section>
          <h2>{t.related}</h2>
          <div class="rels">
            {pg!.related.slice(0, 3).map((k) => <a class="rel" href={href(k, lang)}><strong>{PRODUCT_NAMES[lang][k] ?? (C.pages[k]?.title)}</strong><span>{PRODUCT_LINES[lang][k] ?? (C.pages[k]?.desc.split(/(?<=[.!?])\s/)[0])}</span></a>)}
          </div>
        </section>
      )}
    </div>
  </div>
  </div>
  {aside && <aside class="pside">
      {aside === 'paste' && (
        <figure class="pmock" aria-label={M.h}>
          <p class="pm-h">{M.h}</p>
          <p class="pm-p">{M.p}</p>
          <ul>{M.found.map((f) => <li>{f}</li>)}</ul>
          <div class="pm-b"><span class="pm-btn solid">{M.a}</span><span class="pm-btn">{M.b}</span><span class="pm-btn ghost">{M.c}</span></div>
        </figure>
      )}
      {(aside === 'popup' || aside === 'exam') && (
        <figure class="mock">
          <div class="ui-pop" aria-hidden="true">
            <div class="ui-head"><img src="/favicon.svg" alt="" width="14" height="20">Mindveto</div>
            {aside === 'exam' && <p class="ui-exam">{U.exam}</p>}
            <div class="ui-big"><span>{U.on}</span><small>{U.tapOff}</small></div>
            <p class="ui-st">{U.st}</p>
            <p class="ui-h">{U.cats}</p>
            <ul>{U.c.map(([n, c, on]) => <li><span class={'ui-box' + (on ? ' on' : '')}></span>{n}<small>{c}</small></li>)}</ul>
            <p class="ui-pin">{U.pin}</p>
          </div>
          <figcaption>{U.label}</figcaption>
        </figure>
      )}
      {aside === 'phone' && (
        <figure class="mock">
          <div class="ui-phone" aria-hidden="true">
            <div class="ui-ph-in">
              <p class="ui-ph-t">MINDVETO</p><p class="ui-ph-s">{U.aSub}</p>
              <div class="ui-ph-btn">{U.aOn}</div>
              <p class="ui-ph-tap">{U.aTap}</p>
              <p class="ui-st">{U.aSt}</p>
              <div class="ui-ph-card">{U.aAlways}</div>
            </div>
          </div>
          <figcaption>{U.label}</figcaption>
        </figure>
      )}
      {(aside === 'win' || aside === 'mac' || aside === 'list') && (
        <figure class="mock">
          <pre class="ui-term" role="region" tabindex="0" aria-label={U.label}><code>{aside === 'win' ? `  MINDVETO  -  the AI kill switch

  1) Block AI on this PC
     (or update the list)
  2) Allow AI again
     (remove the block)
  3) Turn off the AI built into
     Windows, Edge and Chrome
     (Copilot, Recall, ...)
  4) Turn that built-in AI back on
  5) Family filter ON
  6) Family filter OFF
  7) Quit

  Choice: 1

  Done: 161 AI addresses are blocked
  on this PC. Restart your browser.` : aside === 'mac' ? `$ sudo sh mindveto.sh on
Password:
Terms: provided "as is" ...
Agree? (y/n) y
Done: 161 AI addresses blocked.
Restart your browser.

$ sudo sh mindveto.sh off
AI is allowed again.` : `! Title: Mindveto AI block list
! Domains: 161
||chatgpt.com^
||chat.openai.com^
||gemini.google.com^
||claude.ai^
||copilot.microsoft.com^
||perplexity.ai^
||chat.deepseek.com^
||character.ai^
...`}</code></pre>
          <figcaption>{U.label}</figcaption>
        </figure>
      )}
      {aside === 'switch' && (
        <figure class="plate mini" aria-hidden="true">
          <span class="switch" aria-checked="true"><span class="screw t"></span><span class="rocker" data-on={h.switchOn} data-off={h.switchOff}><span class="led"></span></span><span class="screw b"></span></span>
          <figcaption class="status">{VETO_CAP[lang]}</figcaption>
        </figure>
      )}
  </aside>}
  </div>
  </>
)}
</Base>
